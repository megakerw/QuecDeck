[Unit]
Description=OpenBSD Secure Shell server
Documentation=man:sshd(8) man:sshd_config(5)
After=network.target opt.mount firewall.service
ConditionPathExists=/usrdata/root/.ssh/authorized_keys
ConditionPathExists=/opt/etc/ssh/quecdeck_enabled

[Service]
Type=simple
PIDFile=/opt/var/run/sshd.pid
# Refuse to bind unless the firewall is up. Its LAN-only rule protects the
# configured SSH port from WAN access. Gate, not Requires=: a firewall restart must not drop live
# sessions. Restart= below retries until the firewall self-heals. Coupling
# pattern for a service that must SURVIVE firewall restarts. See
# firewall.service's ExecStartPost for the must-go-DOWN pattern. Keep in
# sync with the comment there if either pattern changes.
ExecStartPre=/bin/systemctl is-active firewall
ExecStartPre=/bin/sh /usrdata/quecdeck/optional/sshd/update_sshd_ip.sh
ExecStartPre=/usrdata/quecdeck/script/ssh_access.sh ready
ExecStartPre=/opt/sbin/sshd -t
ExecStart=/opt/sbin/sshd -D
# SIGHUP makes sshd re-exec and re-read its configuration, but a reload does not
# run ExecStartPre. sshd accepts a missing Include and then has no ListenAddress
# at all, which means every interface, so republish the fragment first and let a
# failure here abort the reload rather than widen the bind.
ExecReload=/bin/sh /usrdata/quecdeck/optional/sshd/update_sshd_ip.sh
ExecReload=/bin/kill -HUP $MAINPID
KillMode=control-group
TimeoutStopSec=10
Restart=on-failure
# Pace the retry loop under the start-rate limiter (5 starts/10s): the
# default 100ms RestartSec would trip it while the gate fails and park the
# unit in start-limit-hit, never recovering when the firewall comes back.
RestartSec=10

[Install]
WantedBy=multi-user.target
Alias=sshd.service
