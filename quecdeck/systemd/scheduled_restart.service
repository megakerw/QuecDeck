[Unit]
Description=Scheduled Restart Service
After=network.target opt.mount

[Service]
Type=simple
User=www-data
ExecStart=/bin/bash /usrdata/quecdeck/script/scheduled_restart.sh
# Private files created by this www-data service default to owner-only.
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5
ProtectHome=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
