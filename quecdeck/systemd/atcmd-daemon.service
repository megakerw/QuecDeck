[Unit]
Description=quecdeck AT command daemon (atcli --daemon)

[Service]
Type=simple
# The daemon logs to both sinks: the --log tmpfs file (journald is disabled
# on the device) and stderr (journalctl works on firmware where it is not).
# atcli bounds the file to 64 KiB through its retained descriptor and writes a
# rollover marker before the next entry. Recurring faults are also rate-limited
# in the daemon, with the first occurrence and every hundredth written.
# The log lives in /run/quecdeck because ROOT writes it: the daemon opens it
# before dropping privileges, so it must not sit in www-data's tree where the
# file could be redirected through a planted symlink. 0644 keeps it readable by
# the CGI serving the developer log view.
# tmpguard-ok: creates and labels only the top-level web runtime directory in root-owned /run
ExecStartPre=/bin/bash -c 'for D in /run/quecdeck /run/quecdeck-web; do [ ! -L "$D" ] || exit 1; done; mkdir -p /run/quecdeck /run/quecdeck-web; chown root:root /run/quecdeck; chmod 755 /run/quecdeck; chown www-data:www-data /run/quecdeck-web; chmod 700 /run/quecdeck-web'
# Starts as root to open /dev/smd11, drops itself to www-data before
# binding the socket. User= must stay unset. -s is explicit because at-lib.sh
# clients connect to this exact path, not the atcli binary's own default.
# tmpguard-ok: the socket is bound AFTER atcli drops to www-data, so www-data
# is its writer and it correctly lives in www-data's tree. Root never opens it.
ExecStart=/usrdata/quecdeck/atcli --daemon -s /run/quecdeck-web/atcli.sock --log /run/quecdeck/atcmd.log --log-bytes 65536
# tmpguard-ok: rm only, exec'd directly with no shell. Same bounded residual as
# lighttpd.service's wipe: www-data owns the parent and can redirect this to
# unlink an entry named atcli.sock elsewhere. No read or write either way.
ExecStopPost=/bin/rm -f /run/quecdeck-web/atcli.sock
Restart=always
# 5s keeps repeated port-open failures (modem mid-reboot) under systemd's
# default start limit (5 in 10s), which would otherwise park the unit in
# failed state permanently.
RestartSec=5s
StandardOutput=null
StandardError=journal
ProtectHome=yes
LockPersonality=yes
ProtectControlGroups=yes
RestrictRealtime=yes
PrivateNetwork=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
