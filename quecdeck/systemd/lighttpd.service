[Unit]
Description=Lighttpd Daemon
# firewall.service orders after the firmware connection chain and applies its
# policy only after the boot settling boundary. Depending on it here keeps the
# UI down until that protected state is ready.
After=network.target opt.mount QCMAP_ConnectionManagerd.service firewall.service
# Refuse to serve unless the firewall is up, so the UI is never reachable
# without the LAN-only iptables rules in place.
Requires=firewall.service
# Propagate a firewall stop/restart to lighttpd, so a firewall restart cycles it
# too (Requires= alone stops it but won't restart it back). Boot still relies on
# Requires=/After=, since PartOf= does not propagate start.
PartOf=firewall.service

[Service]
Type=simple
# No PIDFile: with -D (foreground) systemd tracks the ExecStart process
# directly. A PIDFile here (the shared opkg path) would let systemd adopt a
# foreign lighttpd, e.g. Entware's, as the main process and mask a bind failure.
ExecStartPre=/bin/sh /usrdata/quecdeck/script/lighttpd_prestart.sh
ExecStartPre=/opt/sbin/lighttpd -tt -f /usrdata/quecdeck/lighttpd.conf
ExecStart=/opt/sbin/lighttpd -D -f /usrdata/quecdeck/lighttpd.conf
ExecReload=/bin/kill -USR1 $MAINPID
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
