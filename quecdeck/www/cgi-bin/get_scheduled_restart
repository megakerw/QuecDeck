#!/bin/bash

. /usrdata/quecdeck/script/cgi-lib.sh
cgi_check_cors

cgi_output_json

device_tz_offset=$(date '+%z')
service_active=false
systemctl is-active scheduled_restart >/dev/null 2>&1 && service_active=true

CONFIG=/usrdata/quecdeck/var/scheduled_restart.json
if [ -s "$CONFIG" ]; then
    base=$(cat "$CONFIG")
else
    base='{"enabled": false, "type": "daily", "day": 1, "hour": 3, "minute": 0}'
fi

printf '%s' "${base%\}}"
printf ', "device_tz_offset": "%s", "service_active": %s}' "$device_tz_offset" "$service_active"
