#!/bin/bash

. /usrdata/quecdeck/script/cgi-lib.sh
cgi_require_post
cgi_read_post

ENABLED=$(get_post_param ENABLED)
TYPE=$(get_post_param TYPE)
DAY=$(get_post_param DAY)
HOUR=$(get_post_param HOUR)
MINUTE=$(get_post_param MINUTE)

# Defaults
ENABLED="${ENABLED:-disable}"
TYPE="${TYPE:-daily}"
DAY="${DAY:-1}"
HOUR="${HOUR:-3}"
MINUTE="${MINUTE:-0}"

# Validate
if ! [[ "$ENABLED" =~ ^(enable|disable)$ ]]; then
    cgi_error "Invalid ENABLED value."
fi
if ! [[ "$TYPE" =~ ^(daily|weekly)$ ]]; then
    cgi_error "TYPE must be 'daily' or 'weekly'."
fi
if ! [[ "$DAY" =~ ^[1-7]$ ]]; then
    cgi_error "DAY must be 1-7 (Mon-Sun)."
fi
if ! [[ "$HOUR" =~ ^[0-9]+$ ]] || [ "$HOUR" -lt 0 ] || [ "$HOUR" -gt 23 ]; then
    cgi_error "HOUR must be 0-23."
fi
if ! [[ "$MINUTE" =~ ^[0-9]+$ ]] || [ "$MINUTE" -lt 0 ] || [ "$MINUTE" -gt 59 ]; then
    cgi_error "MINUTE must be 0-59."
fi

# Keep the generated JSON valid and prevent Bash from treating zero-padded
# hour/minute input as octal.
HOUR=$((10#$HOUR))
MINUTE=$((10#$MINUTE))

enabled_val=$(json_bool "$ENABLED" enable)
CONFIG=/usrdata/quecdeck/var/scheduled_restart.json
new_config="{\"enabled\": $enabled_val, \"type\": \"$TYPE\", \"day\": $DAY, \"hour\": $HOUR, \"minute\": $MINUTE}"

config_changed=0
[ "$(cat "$CONFIG" 2>/dev/null)" != "$new_config" ] && config_changed=1
if [ "$config_changed" = "1" ]; then
    # Written atomically. scheduled_restart.sh reads it at startup.
    write_json_config "$CONFIG" "$new_config"
fi

# Every explicit save reloads the worker, including a retry after a failed
# restart that may have left the old in-memory schedule active. Disabled
# workers start, read the disabled config and exit cleanly.
/opt/bin/sudo /bin/systemctl reset-failed scheduled_restart >/dev/null 2>&1
if ! /opt/bin/sudo /bin/systemctl restart scheduled_restart; then
    cgi_error "Failed to reload scheduled restart settings."
fi

cgi_output_text
if [ "$ENABLED" = "enable" ]; then
    case "$DAY" in
        1) day_name="Monday" ;; 2) day_name="Tuesday" ;; 3) day_name="Wednesday" ;;
        4) day_name="Thursday" ;; 5) day_name="Friday" ;; 6) day_name="Saturday" ;;
        7) day_name="Sunday" ;;
    esac
    time_str=$(printf '%02d:%02d' "$HOUR" "$MINUTE")

    if [ "$TYPE" = "daily" ]; then
        echo "Scheduled restart enabled, daily at ${time_str}."
    else
        echo "Scheduled restart enabled, every ${day_name} at ${time_str}."
    fi
else
    echo "Scheduled restart disabled."
fi

exit 0
