#!/bin/bash

. /usrdata/quecdeck/script/cgi-lib.sh
cgi_check_cors
case "${REQUEST_METHOD:-GET}" in
    GET|POST) ;;
    *)
        printf 'Status: 405 Method Not Allowed\r\nAllow: GET, POST\r\nContent-type: text/plain\r\n\r\nMethod Not Allowed\n'
        exit 1
        ;;
esac
cgi_output_json

LOG=/run/quecdeck/install.log
OPERATION_FILE=/run/quecdeck/update.operation

# Acknowledgement is scoped so a delayed client cannot clear a newer result.
if [ "${REQUEST_METHOD:-GET}" = POST ]; then
    cgi_read_post 256
    ack_id=$(get_post_param operation_id)
    case "$ack_id" in *[!a-f0-9]*|'') printf '{"ok":false,"error":"Invalid operation ID"}\n'; exit 0 ;; esac
    [ "${#ack_id}" -eq 32 ] || { printf '{"ok":false,"error":"Invalid operation ID"}\n'; exit 0; }
    /opt/bin/sudo /usrdata/quecdeck/script/run_update.sh --clear-status "$ack_id" >/dev/null 2>&1
    printf '{"ok":true}\n'
    exit 0
fi

idle_response() {
    printf '{"log":"","offset":0,"status":"idle","kind":"","operation_id":"","code":0,"rollback":"none","version":""}\n'
}

offset=$(printf '%s' "${QUERY_STRING:-}" | tr '&' '\n' | grep '^offset=' | cut -d= -f2)
case "$offset" in ''|*[!0-9]*) offset=0 ;; esac
[ "${#offset}" -le 10 ] || offset=0

if [ ! -f "$OPERATION_FILE" ]; then
    idle_response
    exit 0
fi

# Validate the complete record before reflecting any field into JSON.
IFS=' ' read -r operation_id kind status code rollback < "$OPERATION_FILE"
valid_record=1
case "$operation_id" in *[!a-f0-9]*|'') valid_record=0 ;; esac
[ "${#operation_id}" -eq 32 ] || valid_record=0
case "$kind" in quecdeck|sshd:install|sshd:update|sshd:uninstall|sshd:check) ;; *) valid_record=0 ;; esac
case "$status" in running|done|failed) ;; *) valid_record=0 ;; esac
case "$code" in 0|[1-9]|[1-9][0-9]|[1-9][0-9][0-9]) ;; *) valid_record=0 ;; esac
case "$rollback" in none|ok|failed) ;; *) valid_record=0 ;; esac
if [ "$valid_record" != 1 ]; then
    idle_response
    exit 0
fi

if [ -f "$LOG" ]; then
    total=$(wc -c < "$LOG" | tr -d ' ')
    [ "$offset" -gt "$total" ] && offset=0
    chunk_b64=$(tail -c "+$((offset + 1))" "$LOG" | tr -d '\033' | sed 's/\[[0-9;]*m//g' | base64 | tr -d '\n')
else
    total=0
    chunk_b64=""
fi

version=""
[ "$status" = done ] && [ "$kind" = quecdeck ] &&
    version=$(cat /usrdata/quecdeck/version 2>/dev/null | tr -cd '0-9A-Za-z.-')

if [ "$status" = running ]; then
    if [ "$(systemctl is-active install_quecdeck 2>/dev/null)" = failed ] ||
       [ "$(systemctl is-active install_quecdeck_fetch 2>/dev/null)" = failed ] ||
       [ "$(systemctl is-active install_quecdeck_sshd 2>/dev/null)" = failed ]; then
        status=failed
    fi
fi

printf '{"log":"%s","offset":%s,"status":"%s","rollback":"%s","version":"%s","kind":"%s","operation_id":"%s","code":%s}\n' \
    "$chunk_b64" "$total" "$status" "$rollback" "$version" "$kind" "$operation_id" "$code"
