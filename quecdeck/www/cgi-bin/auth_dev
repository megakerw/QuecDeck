#!/bin/bash
# Developer session unlock endpoint.
#
# Requires an active admin session (enforced by auth.lua before this script
# runs). Checks the provided password against /opt/etc/.htpasswd_dev using
# the fixed "devadmin" username.
#
# GET: returns {"unlocked": true/false} for the current session.
# POST validates the password. On success it sets the dev-unlock flag and returns
#        {"unlocked": true}.
#
# Brute-force protection: 5 failed attempts trigger a 15-minute lockout,
# tracked per client IP under the web runtime tree (mirroring
# auth_login). Per-session tracking would let an attacker who already holds
# admin reset the counter by simply logging in again, since each login mints a
# fresh session file.

. /usrdata/quecdeck/script/cgi-lib.sh

# Most responses here are a single small JSON line (with header).
_json() { cgi_output_json; printf '%s\n' "$1"; }

# Extract session token from Cookie header.
token=$(printf '%s' "${HTTP_COOKIE:-}" | tr ';' '\n' | sed 's/^ *//' | \
    grep '^session=' | head -1 | cut -d= -f2)

# Validate the token format before using it in a file path. This is defense in
# depth because auth.lua enforces the same constraint before this script runs.
if ! printf '%s' "$token" | grep -qE '^[A-Za-z0-9]{1,128}$'; then
    _json '{"unlocked":false}'
    exit 0
fi

SESSION_FILE="/run/quecdeck-web/sessions/${token}"
# The dev-unlock flag lives in a sibling "<token>.dev" file rather than inside
# the session file. auth.lua rewrites the session file on every request (to
# refresh last_access). Keeping developer state in a separate file prevents
# that frequent rewrite from clobbering the flag. The credential generation
# closes races with password rotation without adding a shared session lock.
DEV_FILE="${SESSION_FILE}.dev"
GENERATION_FILE=/opt/etc/.htpasswd_dev.generation

read_generation() {
    local value
    IFS= read -r value < "$GENERATION_FILE" 2>/dev/null || return 1
    printf '%s' "$value" | grep -qE '^[a-f0-9]{32}$' || return 1
    printf '%s' "$value"
}

if [ ! -f "$SESSION_FILE" ]; then
    _json '{"unlocked":false}'
    exit 0
fi

dev_unlocked=$(grep '^dev_unlocked=' "$DEV_FILE" 2>/dev/null | cut -d= -f2)
dev_generation=$(grep '^generation=' "$DEV_FILE" 2>/dev/null | cut -d= -f2)
current_generation=$(read_generation 2>/dev/null) || current_generation=""

# GET: return current unlock status and whether a dev password has been configured.
if [ "$REQUEST_METHOD" = "GET" ]; then
    configured="false"
    [ -s /opt/etc/.htpasswd_dev ] && configured="true"
    if [ "$dev_unlocked" = "1" ] && [ -n "$current_generation" ] &&
       [ "$dev_generation" = "$current_generation" ]; then
        unlocked="true"
    else
        unlocked="false"
    fi
    _json "$(printf '{"unlocked":%s,"configured":%s}' "$unlocked" "$configured")"
    exit 0
fi

# POST: attempt to unlock.
cgi_require_post
cgi_read_post
password=$(get_post_param "password")

if [ -z "$password" ] || [ "${#password}" -gt 256 ]; then
    _json '{"unlocked":false,"error":"invalid"}'
    exit 0
fi

now=$(date +%s)
ACCESS_LOG="/run/quecdeck-web/logs/access_events.jsonl"
client_ip=$(cgi_client_ip)
wan_ip=$(cgi_wan_ip)

# Brute-force protection per client IP (rationale in the header comment).
FAILURE_DIR="/run/quecdeck-web/dev-auth-failures"

# Reject immediately if locked out.
if ! cgi_flock_available; then
    _json '{"unlocked":false,"error":"locked"}'
    exit 0
fi
if ! bf_lock "$FAILURE_DIR" "$client_ip"; then
    _json '{"unlocked":false,"error":"locked"}'
    exit 0
fi
if bf_locked "$FAILURE_DIR" "$client_ip"; then
    log_access_event "$ACCESS_LOG" "{\"ts\":$now,\"type\":\"dev_unlock_locked\",\"ip\":\"$client_ip\",\"wan_ip\":\"$wan_ip\"}"
    bf_unlock
    _json '{"unlocked":false,"error":"locked"}'
    exit 0
fi

generation_before=$(read_generation) || {
    bf_unlock
    _json '{"unlocked":false,"error":"unavailable"}'
    exit 0
}
validate_password dev devadmin "$password"
password_rc=$?
if [ "$password_rc" = 75 ]; then
    bf_unlock
    _json '{"unlocked":false,"error":"unavailable"}'
elif [ "$password_rc" = 0 ]; then
    # Bind the unlock to the credential generation. Rechecking after the
    # rename closes a rotation that overlaps password verification.
    if ! (umask 077; printf 'dev_unlocked=1\ngeneration=%s\ncreated=%s\n' \
         "$generation_before" "$(date +%s)" > "${DEV_FILE}.tmp.$$") ||
       ! mv "${DEV_FILE}.tmp.$$" "$DEV_FILE"; then
        rm -f "${DEV_FILE}.tmp.$$"
        bf_unlock
        _json '{"unlocked":false,"error":"unavailable"}'
        exit 0
    fi
    generation_after=$(read_generation 2>/dev/null) || generation_after=""
    if [ "$generation_before" != "$generation_after" ]; then
        rm -f "$DEV_FILE"
        bf_unlock
        _json '{"unlocked":false,"error":"unavailable"}'
        exit 0
    fi
    bf_clear "$FAILURE_DIR" "$client_ip"
    bf_unlock
    log_access_event "$ACCESS_LOG" "{\"ts\":$now,\"type\":\"dev_unlock_success\",\"ip\":\"$client_ip\",\"wan_ip\":\"$wan_ip\"}"
    _json '{"unlocked":true}'
else
    bf_fail "$FAILURE_DIR" "$client_ip"
    result=$BF_FAIL_RESULT
    bf_unlock
    if [ "$result" = "locked" ]; then
        log_access_event "$ACCESS_LOG" "{\"ts\":$now,\"type\":\"dev_unlock_locked\",\"ip\":\"$client_ip\",\"wan_ip\":\"$wan_ip\"}"
        _json '{"unlocked":false,"error":"locked"}'
    else
        log_access_event "$ACCESS_LOG" "{\"ts\":$now,\"type\":\"dev_unlock_failure\",\"ip\":\"$client_ip\",\"wan_ip\":\"$wan_ip\"}"
        _json '{"unlocked":false,"error":"wrong"}'
    fi
fi
