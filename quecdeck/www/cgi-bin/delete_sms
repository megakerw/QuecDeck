#!/bin/bash

. /usrdata/quecdeck/script/cgi-lib.sh

# Delete a space- or comma-separated slot list, one command per slot. Echoes OK,
# or an ERROR naming how many parts still hold a message or were left
# unattempted when the budget expired. An already-empty slot counts as done.
# Top-level so tests/host/run-tests.sh can extract it and drive it with a
# stubbed atcmd_run.
#
# Do not chain slots into one command. The flash write dominates, so chaining
# costs 21 ms/slot against 20 ms single and only adds two caps to stay under:
# the daemon's CMD_MAX of 512 and a modem-side limit near 80 commands. A
# single-slot line is ~30 chars, so neither can bind.
# Measurements in tools/sms-delete-flow.md.
delete_sms_indices() {
    # CPMS re-selected per line: index numbering is per-storage and another CGI
    # can change the selection between ours. <mem1> only, so the write and
    # receive stores keep pointing where arriving messages already land
    # (device-verified 2026-08-06).
    local at_pfx='AT+CPMS="ME"'
    local failed=0 total=0 idx reply deadline expired=0

    # Overall budget, so a global fault (daemon restarting, store busy) cannot
    # hold the serialized AT port for minutes. Unattempted slots count as
    # failed. Sized against the manual's worst-case 300 ms per +CMGD rather
    # than the 20 ms a delete costs. Not a ceiling: a slot starts only if its
    # own timeout still fits.
    local budget=45 slot_tmo=2
    _epoch_now
    deadline=$(( _NOW + budget ))

    # Unquoted for the word splitting. valid_slot_list has limited this to
    # digits and commas, so globbing has nothing to match.
    for idx in ${1//,/ }; do
        total=$((total + 1))
        _epoch_now
        if [ $(( _NOW + slot_tmo )) -gt "$deadline" ]; then
            expired=1
            failed=$((failed + 1))
            continue
        fi
        reply=$(atcmd_run "${at_pfx};+CMGD=${idx}" $(( slot_tmo * 1000 )))
        at_response_ok "$reply" && continue
        # 321 = invalid memory index = the slot holds no message, the end state
        # asked for. $failed means "still holds a message". The RM520N answers
        # "+CMS ERROR: 321" identically at CMEE 0, 1 and 2 (device-probed
        # 2026-08-06), so the literal match is safe.
        #
        # Match the +CPMS: line first. A 321 raised by the storage selection
        # would otherwise read as "empty" for every slot in the request, and
        # the page would be told OK with the messages still there.
        case $reply in *'+CPMS:'*'+CMS ERROR: 321'*) continue ;; esac
        failed=$((failed + 1))
    done

    if [ "$expired" -eq 1 ]; then
        echo "ERROR: hit the ${budget}s time budget with $failed of $total message parts left"
    elif [ "$failed" -gt 0 ]; then
        echo "ERROR: $failed of $total message parts could not be deleted"
    else
        echo "OK"
    fi
}

# Slot lists go straight into an AT command line, so this is the boundary that
# keeps everything else out. Equivalent to ^[0-9]+(,[0-9]+)*$ without the fork.
valid_slot_list() {
    case $1 in ''|*[!0-9,]*) return 1 ;; esac
    case $1 in ,*|*,,*|*,) return 1 ;; esac
    return 0
}

cgi_require_post
cgi_read_post

indices=$(get_post_param indices)

cgi_output_text

# Always by index, even when everything is selected. AT+CMGD=1,4 erases the
# whole store, including messages that arrived while the page was open, and the
# UI's "delete all" means the ones on screen.
if [ -z "$indices" ]; then
    cgi_error "ERROR: provide indices=N,N,..."
fi
if ! valid_slot_list "$indices"; then
    cgi_error "ERROR: indices must be comma-separated integers"
fi

delete_sms_indices "$indices"
