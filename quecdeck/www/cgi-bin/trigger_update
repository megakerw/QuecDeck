#!/bin/bash

. /usrdata/quecdeck/script/cgi-lib.sh
cgi_require_post
cgi_read_post
cgi_output_json

tag=$(get_post_param tag)
operation_id=$(cgi_new_operation_id) || {
    printf '{"ok":false,"error":"Could not create operation ID"}\n'
    exit 0
}

# Tags enter systemd unit text and must match one complete line.
if ! [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    printf '{"ok":false,"error":"Invalid version tag"}\n'
    exit 0
fi
# Exit code 2 means another background operation owns the dispatch slot.
/opt/bin/sudo /usrdata/quecdeck/script/run_update.sh "$tag" "$operation_id" >/dev/null
rc=$?
if [ "$rc" -eq 2 ]; then
    printf '{"ok":false,"error":"An update is already in progress"}\n'
    exit 0
elif [ "$rc" -ne 0 ]; then
    printf '{"ok":false,"error":"Failed to start update process"}\n'
    exit 0
fi

printf '{"ok":true,"tag":"%s","operation_id":"%s"}\n' "$tag" "$operation_id"
