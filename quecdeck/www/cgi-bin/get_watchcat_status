#!/bin/bash

. /usrdata/quecdeck/script/cgi-lib.sh
cgi_check_cors

cgi_output_json

service_active=false
systemctl is-active watchcat >/dev/null 2>&1 && service_active=true

CONFIG=/usrdata/quecdeck/var/watchcat.json
if [ -s "$CONFIG" ]; then
    base=$(cat "$CONFIG")
else
    base='{"enabled": false}'
fi

printf '%s' "${base%\}}"
printf ', "service_active": %s}\n' "$service_active"
