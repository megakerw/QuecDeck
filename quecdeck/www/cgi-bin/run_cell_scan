#!/bin/bash

. /usrdata/quecdeck/script/cgi-lib.sh
cgi_require_post
cgi_read_post

# AT+QSCAN mode: 1=LTE only, 2=NR5G only, 3=both (default).
scan_mode=$(get_post_param mode)
case "$scan_mode" in
    1|2|3) ;;
    *) scan_mode=3 ;;
esac

# Serialize scans. A concurrent scan that stops/starts watchcat or clears the
# qscan.active flag out from under this one can leave watchcat running mid-scan
# (risking a reboot) or stopped indefinitely. Hold an exclusive lock for the
# whole scan so a second invocation is rejected rather than interleaving. The
# kernel releases an flock when the holding process dies (even on SIGKILL), so
# a crashed scan can't wedge the lock. Degrade to no guard if flock is missing
# rather than blocking scans entirely.
# umask, not a bare mkdir: this can be the first creator of /tmp/quecdeck, and
# no root unit re-tightens that parent any more. Without it the dir persists at
# the CGI umask (0755) and the 0644 cache files under it become world-readable.
(umask 077; mkdir -p /tmp/quecdeck)
if command -v flock >/dev/null 2>&1; then
    exec 9>/tmp/quecdeck/qscan.lock
    if ! flock -n 9; then
        printf 'Status: 409 Conflict\r\n'
        cgi_output_text
        echo "ERROR: A cell scan is already in progress."
        exit 0
    fi
fi

cgi_output_text

# Pause watchcat for the duration of the scan.
# AT+QSCAN drops the modem's network connection, so watchcat would rack up
# ping failures and potentially trigger a modem reboot mid-scan.
CONN_LOG="/tmp/quecdeck/logs/connection_events.jsonl"
log_scan_event() {
    mkdir -p "$(dirname "$CONN_LOG")" && chmod 700 "$(dirname "$CONN_LOG")"
    printf '%s\n' "$1" >> "$CONN_LOG"
    local count
    count=$(wc -l < "$CONN_LOG" 2>/dev/null || echo 0)
    if [ "$count" -gt 500 ]; then
        tail -500 "$CONN_LOG" > "${CONN_LOG}.tmp" && mv "${CONN_LOG}.tmp" "$CONN_LOG"
    fi
}

# is-active is a read-only query that works without sudo.
watchcat_was_running=0
if /bin/systemctl is-active watchcat > /dev/null 2>&1; then
    watchcat_was_running=1
    /opt/bin/sudo /bin/systemctl stop watchcat 2>/dev/null
fi

log_scan_event "{\"ts\":$(date +%s),\"type\":\"cell_scan_start\",\"watchcat_paused\":$(json_bool "$watchcat_was_running" 1)}"

# Signal to cache_get_or_fetch that the modem is busy. CGIs will serve
# existing cached data rather than attempting live AT commands.
touch /tmp/quecdeck/qscan.active

# On exit: remove scan flag and temp file, invalidate stale modem caches, and
# restart watchcat if it was running before the scan.
scan_tmp=$(mktemp)
_scan_exit() {
    log_scan_event "{\"ts\":$(date +%s),\"type\":\"cell_scan_end\",\"watchcat_paused\":$(json_bool "$watchcat_was_running" 1)}"
    rm -f "$scan_tmp" /tmp/quecdeck/qscan.active
    # Invalidate all caches. AT+QSCAN drops the cellular connection, causing the
    # modem to emit registration URCs on reconnect that can mix into subsequent AT
    # responses and poison any cache written immediately after the scan. A full
    # flush ensures every page gets a clean fetch once the modem has settled.
    cache_invalidate "$_CACHE_MODEM_ALL" "$_CACHE_NETWORK" "$_CACHE_NEIGHBOUR" \
        "$_CACHE_DEVICE_INFO" "$_CACHE_SETTINGS"
}
if [ "$watchcat_was_running" = "1" ]; then
    trap '_scan_exit; /opt/bin/sudo /bin/systemctl start watchcat' EXIT
else
    trap '_scan_exit' EXIT
fi

# Run the cell scan in the background. Outer timeout = 215 s (180 s max scan +
# 35 s handler overhead). The optional third AT+QSCAN parameter (firmware scan
# duration) is omitted. On this firmware it causes some scan modes to return
# immediate OK with no results.
#
# The scan runs in the background so we can emit keepalive newlines every second.
# A scan can run for up to 215 seconds with nothing to send. Without the
# newlines, a gap longer than lighttpd's max-keep-alive-idle (45s) would drop
# the connection mid-scan. JS filters empty lines (lines[i] !== "") so keepalive
# newlines are invisible to the parser.
#
# Device-measured 2026-07-31: the modem emits no +QSCAN: lines as it finds
# cells. Nothing arrives until the sweep is done, then the whole block lands
# just before OK (warm full scan: 39 cells at once, ~7 s). A scan cut short is
# therefore empty, so the marker below is the only signal the user gets.
atcmd_run "AT+QSCAN=${scan_mode},1" 215000 > "$scan_tmp" &
scan_pid=$!

while kill -0 "$scan_pid" 2>/dev/null; do
    printf '\n'
    sleep 1
done

# Reaped by the loop or not, bash keeps a known child's status for wait.
wait "$scan_pid"
scan_rc=$?

cat "$scan_tmp"

# The rows above are real, so this is a marker rather than an ERROR. It must
# contain neither "LTE" nor "NR5G", or the row filter in scanner.js takes it
# for a cell.
if [ "$scan_rc" -ne 0 ]; then
    echo "PARTIAL: scan ended before the modem finished"
fi
