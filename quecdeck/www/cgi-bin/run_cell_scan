#!/bin/bash

. /usrdata/quecdeck/script/cgi-lib.sh
. /usrdata/quecdeck/script/connection-log.sh || exit 1
cgi_require_post
cgi_read_post

# AT+QSCAN mode: 1=LTE only, 2=NR5G only, 3=both (default).
scan_mode=$(get_post_param mode)
case "$scan_mode" in
    1|2|3) ;;
    *) scan_mode=3 ;;
esac

# Serialize scans. A concurrent scan that stops/starts watchcat or clears the
# qscan.active flag out from under this one can leave watchcat running mid-scan
# (risking a reboot) or stopped indefinitely. Hold an exclusive lock for the
# whole scan so a second invocation is rejected rather than interleaving. The
# kernel releases an flock when the holding process dies (even on SIGKILL), so
# a crashed scan can't wedge the lock. Scanning is refused if flock is missing:
# running concurrent scans would invalidate the Watchcat and AT-command guards.
# The runtime unit creates the private web-owned scan directory before the web
# server starts.
if ! cgi_flock_available; then
    printf 'Status: 500 Internal Server Error\r\n'
    cgi_output_text
    echo "ERROR: Cell scanning requires flock, which is unavailable on this device."
    exit 0
fi
mkdir -p /run/quecdeck-web/scan
exec 9>/run/quecdeck-web/scan/lock
if ! flock -n 9; then
    printf 'Status: 409 Conflict\r\n'
    cgi_output_text
    echo "ERROR: A cell scan is already in progress."
    exit 0
fi

# Pause watchcat for the duration of the scan. AT+QSCAN drops the modem's
# network connection, so watchcat would rack up ping failures and potentially
# trigger a modem reboot mid-scan.
#
# Pause rather than stop: a settings save restarting the unit mid-scan would
# cancel a stop, but not this. 240s outlives the 215s outer timeout below, and
# expires on its own if this CGI dies before the trap runs. The marker also
# covers a worker started by a concurrent settings save.
watchcat_pause_for_disruption scan 240
pause_rc=$?
watchcat_was_watching=$WATCHCAT_WAS_ACTIVE
if [ "$pause_rc" != "0" ]; then
    printf 'Status: 500 Internal Server Error\r\n'
    cgi_output_text
    echo "ERROR: Could not pause Watchcat, so the scan was not started."
    exit 0
fi

# Publish a monotonic scan guard before starting any modem work. Cache readers
# fail closed while it is live, and can discard it after five minutes if this
# CGI is killed before its EXIT trap runs.
qscan_now=$(watchcat_uptime)
if [ -z "$qscan_now" ] \
    || ! watchcat_atomic_write "$_QSCAN_ACTIVE" "$((qscan_now + QSCAN_GUARD_SECS))"; then
    watchcat_resume scan
    printf 'Status: 500 Internal Server Error\r\n'
    cgi_output_text
    echo "ERROR: Could not establish the cell-scan guard, so the scan was not started."
    exit 0
fi

if ! connection_log_append "{\"ts\":$(date +%s),\"type\":\"cell_scan_start\",\"watchcat_paused\":$watchcat_was_watching}"; then
    watchcat_resume scan
    rm -f "$_QSCAN_ACTIVE"
    printf 'Status: 500 Internal Server Error\r\n'
    cgi_output_text
    echo "ERROR: Could not write the connection event log, so the scan was not started."
    exit 0
fi

cgi_output_text

# On exit: resume watchcat, remove the scan flag and temp file, and invalidate
# stale modem caches. One trap for every case, now that resuming is
# unconditional.
scan_tmp=$(mktemp)
_scan_exit() {
    connection_log_append "{\"ts\":$(date +%s),\"type\":\"cell_scan_end\",\"watchcat_paused\":$watchcat_was_watching}" \
        || printf '%s\n' 'run_cell_scan: could not write the completion event' >&2
    watchcat_resume scan
    scan_settle_now=$(watchcat_uptime)
    if [ -n "$scan_settle_now" ]; then
        watchcat_atomic_write /run/quecdeck-web/scan/settle "$((scan_settle_now + 60))" \
            || printf '%s\n' 'run_cell_scan: could not establish the logger settling window' >&2
    fi
    rm -f "$scan_tmp" "$_QSCAN_ACTIVE"
    # Invalidate all caches. AT+QSCAN drops the cellular connection, causing the
    # modem to emit registration URCs on reconnect that can mix into subsequent AT
    # responses and poison any cache written immediately after the scan. A full
    # flush ensures every page gets a clean fetch once the modem has settled.
    cache_invalidate "$_CACHE_MODEM_ALL" "$_CACHE_NETWORK" "$_CACHE_NEIGHBOUR" \
        "$_CACHE_DEVICE_INFO" "$_CACHE_SETTINGS"
}
trap '_scan_exit' EXIT

# Run the cell scan in the background. Outer timeout = 215 s (180 s max scan +
# 35 s handler overhead). The optional third AT+QSCAN parameter (firmware scan
# duration) is omitted. On this firmware it causes some scan modes to return
# immediate OK with no results.
#
# The scan runs in the background so we can emit keepalive newlines every second.
# A scan can run for up to 215 seconds with nothing to send. Without the
# newlines, a gap longer than lighttpd's max-keep-alive-idle (45s) would drop
# the connection mid-scan. JS filters empty lines (lines[i] !== "") so keepalive
# newlines are invisible to the parser.
#
# Device-measured 2026-07-31: the modem emits no +QSCAN: lines as it finds
# cells. Nothing arrives until the sweep is done, then the whole block lands
# just before OK (warm full scan: 39 cells at once, ~7 s). A scan cut short is
# therefore empty, so the marker below is the only signal the user gets.
atcmd_run "AT+QSCAN=${scan_mode},1" 215000 > "$scan_tmp" &
scan_pid=$!

while kill -0 "$scan_pid" 2>/dev/null; do
    printf '\n'
    sleep 1
done

# Reaped by the loop or not, bash keeps a known child's status for wait.
wait "$scan_pid"
scan_rc=$?

cat "$scan_tmp"

# The rows above are real, so this is a marker rather than an ERROR. It must
# contain neither "LTE" nor "NR5G", or the row filter in scanner.js takes it
# for a cell.
if [ "$scan_rc" -ne 0 ]; then
    echo "PARTIAL: scan ended before the modem finished"
fi
