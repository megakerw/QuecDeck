#!/bin/bash

. /usrdata/quecdeck/script/cgi-lib.sh
cgi_require_post
cgi_read_post

WATCHCAT_ENABLED=$(get_post_param WATCHCAT_ENABLED)
PING_INTERVAL=$(get_post_param PING_INTERVAL)
PING_FAILURE_COUNT=$(get_post_param PING_FAILURE_COUNT)
DISABLE_ON_NO_SIM=$(get_post_param DISABLE_ON_NO_SIM)
REBOOT_BACKOFF=$(get_post_param REBOOT_BACKOFF)
LOG_RESTARTS=$(get_post_param LOG_RESTARTS)

# Collect and validate IPs
TRACK_IPS_COLON=""
for i in 1 2 3 4 5 6; do
    ip=$(get_post_param "TRACK_IP_${i}")
    if [ -n "$ip" ]; then
        if valid_ipv4 "$ip"; then
            [ -n "$TRACK_IPS_COLON" ] && TRACK_IPS_COLON="${TRACK_IPS_COLON}:${ip}" || TRACK_IPS_COLON="$ip"
        else
            cgi_error "Invalid IP address: $ip"
        fi
    fi
done

# Defaults
WATCHCAT_ENABLED="${WATCHCAT_ENABLED:-disable}"
PING_INTERVAL="${PING_INTERVAL:-30}"
PING_FAILURE_COUNT="${PING_FAILURE_COUNT:-3}"
DISABLE_ON_NO_SIM="${DISABLE_ON_NO_SIM:-1}"
REBOOT_BACKOFF="${REBOOT_BACKOFF:-1}"
LOG_RESTARTS="${LOG_RESTARTS:-1}"

# Validate
if ! [[ "$WATCHCAT_ENABLED" =~ ^(enable|disable)$ ]]; then
    cgi_error "Invalid value for WATCHCAT_ENABLED."
fi

if ! [[ "$REBOOT_BACKOFF" =~ ^[01]$ ]]; then
    cgi_error "REBOOT_BACKOFF must be 0 or 1."
fi

if ! [[ "$LOG_RESTARTS" =~ ^[01]$ ]]; then
    cgi_error "LOG_RESTARTS must be 0 or 1."
fi

if [ "$WATCHCAT_ENABLED" = "enable" ] && [ -z "$TRACK_IPS_COLON" ]; then
    cgi_error "At least one valid IP address is required to enable Watchcat."
fi

if ! [[ "$PING_INTERVAL" =~ ^[0-9]+$ ]] || [ "$PING_INTERVAL" -lt 10 ] || [ "$PING_INTERVAL" -gt 600 ]; then
    cgi_error "Ping interval must be between 10 and 600 seconds."
fi

if ! [[ "$PING_FAILURE_COUNT" =~ ^[0-9]+$ ]] || [ "$PING_FAILURE_COUNT" -lt 3 ] || [ "$PING_FAILURE_COUNT" -gt 10 ]; then
    cgi_error "Failure count must be between 3 and 10."
fi

if ! [[ "$DISABLE_ON_NO_SIM" =~ ^[01]$ ]]; then
    cgi_error "DISABLE_ON_NO_SIM must be 0 or 1."
fi

# Bash arithmetic treats a leading zero as octal, while JSON numbers cannot
# have leading zeroes. Normalize validated decimal input before either use.
PING_INTERVAL=$((10#$PING_INTERVAL))
PING_FAILURE_COUNT=$((10#$PING_FAILURE_COUNT))

# Build JSON array of IPs
ips_space=$(echo "$TRACK_IPS_COLON" | tr ':' ' ')
ips_json="["
first=1
for ip in $ips_space; do
    [ "$first" = "1" ] && first=0 || ips_json="$ips_json,"
    ips_json="$ips_json\"$ip\""
done
ips_json="$ips_json]"

sim_val=$(json_bool "$DISABLE_ON_NO_SIM" 1)
backoff_val=$(json_bool "$REBOOT_BACKOFF" 1)
log_val=$(json_bool "$LOG_RESTARTS" 1)
enabled_val=$(json_bool "$WATCHCAT_ENABLED" enable)

CONFIG=/usrdata/quecdeck/var/watchcat.json
new_config="{\"enabled\": $enabled_val, \"track_ips\": $ips_json, \"ping_interval\": $PING_INTERVAL, \"ping_failure_count\": $PING_FAILURE_COUNT, \"disable_on_no_sim\": $sim_val, \"reboot_backoff\": $backoff_val, \"log_restarts\": $log_val}"

# Command substitution strips the trailing newline written by write_json_config,
# so this compares like for like.
config_changed=0
[ "$(cat "$CONFIG" 2>/dev/null)" != "$new_config" ] && config_changed=1

# Kept separate from the restart decision below. Both files are
# per-configuration state, and the reboot streak in particular must survive a
# restart that only happened because the worker was down: wiping it there would
# drop an escalated backoff back to its base and start the flash-wear
# escalation over.
if [ "$config_changed" = "1" ]; then
    # Commit the new configuration before discarding the old configuration's
    # safety state. A failed write must leave its reboot backoff intact.
    write_json_config "$CONFIG" "$new_config"
    rm -f /usrdata/quecdeck/var/watchcat_reboot_state.json
    rm -f /tmp/quecdeck/watchcat_stats.json
fi

# Every explicit save reloads the worker. If a previous restart failed while
# the old process remained active, the file already contains the requested
# config and change detection alone cannot tell that the process is stale.
# Disabled workers start, read the disabled config and exit cleanly.
/opt/bin/sudo /bin/systemctl reset-failed watchcat >/dev/null 2>&1
if ! /opt/bin/sudo /bin/systemctl restart watchcat; then
    cgi_error "Failed to reload Watchcat settings."
fi

cgi_output_text
if [ "$WATCHCAT_ENABLED" = "enable" ]; then
    echo "Watchcat started. Targets: $ips_space | Interval: ${PING_INTERVAL}s | Failures: $PING_FAILURE_COUNT | SIM check: $DISABLE_ON_NO_SIM"
else
    echo "Watchcat disabled."
fi

exit 0
